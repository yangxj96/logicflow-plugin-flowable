{
    "name": "@yangxj96/logicflow-plugin-flowable",
    "version": "0.1.2",
    "description": "基于 LogicFlow 的 Flowable / BPMN 2.0 流程建模与可视化扩展插件",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yangxj96/logicflow-plugin-flowable.git"
    },
    "bugs": {
        "url": "https://github.com/yangxj96/logicflow-plugin-flowable/issues"
    },
    "homepage": "https://github.com/yangxj96/logicflow-plugin-flowable#readme",
    "keywords": [
        "bpmn",
        "flowable",
        "logicflow",
        "workflow",
        "process-designer"
    ],
    "author": {
        "name": "yangxj96",
        "url": "https://github.com/yangxj96"
    },
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./style.css": "./dist/index.css",
        "./dist/index.css": "./dist/index.css"
    },
    "files": [
        "dist/index.js",
        "dist/index.cjs",
        "dist/index.d.ts",
        "dist/index.d.cts",
        "dist/index.css",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "prepublishOnly": "npm run build",
        "dev": "tsup --watch",
        "format": "prettier --write ./src ./scripts tsup.config.ts",
        "format:check": "prettier --check ./src ./scripts tsup.config.ts"
    },
    "peerDependencies": {
        "@logicflow/core": "^2.1.11",
        "@logicflow/extension": "^2.1.11",
        "element-plus": ">=2.13.2 <3",
        "preact": "^10.17.1",
        "vue": ">=3.5.28 <4"
    },
    "peerDependenciesMeta": {
        "preact": {
            "optional": true
        }
    },
    "devDependencies": {
        "@logicflow/core": "^2.1.11",
        "@logicflow/extension": "^2.1.11",
        "nanoid": "3.3.17",
        "postcss": "8.5.23",
        "preact": "^10.17.1",
        "prettier": "^3.7.4",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "engines": {
        "node": ">=18"
    }
}
